# ============================================================
# HireMe — Environment Configuration
# ============================================================
# RECOMMENDED SETUP FOR SHARING WITH FRIENDS:
#   1. Get a FREE Gemini API key at https://aistudio.google.com/apikey
#      (no billing required, 1500 requests/day free)
#   2. Configure it in the app UI: Settings → Add provider → Google Gemini
#      OR paste it as GEMINI_API_KEY below (UI method is preferred for sharing)
#   3. For embeddings (job matching), also set EMBEDDING_PROVIDER=gemini
#      so Ollama is NOT required.
# ============================================================

# ---- Primary LLM provider (chat, resume parsing, cover letters) ----
# Recommended: Google Gemini free tier — no billing needed, 1500 req/day.
# Configure via the UI (/settings → Add provider) so each friend uses their own key.
# Fallback: set here if you prefer env-based config.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# Alternative paid providers (only one is used at a time; Gemini takes priority):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Embeddings provider (powers job matching) ----
# Use EMBEDDING_PROVIDER=gemini to avoid needing Ollama installed.
# All embeddings in one DB MUST use the same model — if you switch, reset + re-embed.
# (npm run db:reset, then re-upload resume and run a full sync)
#
#   EMBEDDING_PROVIDER=ollama | gemini | openai | openai-compatible   (default: ollama)
#   EMBEDDING_MODEL=...        # optional; defaults: nomic-embed-text / text-embedding-004
#   EMBEDDING_API_KEY=...      # falls back to GEMINI_API_KEY / OPENAI_API_KEY
#   EMBEDDING_BASE_URL=...     # REQUIRED for openai-compatible providers
#
# Recommended for no-Ollama setup:
EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=AIza...   # Leave unset to reuse GEMINI_API_KEY


# ---- Matching & freshness (Phase 1/3) ----
# How many top matches to show/cache and auto-evaluate per run (the "best fits" count, 20-50).
# MATCH_LIMIT=30
# Retire jobs not re-seen at their source for this many days (prune-stale). Default 21.
# STALE_DAYS=21
# Re-check a job URL's liveness at most once per this many hours (verify-links). Default 24.
# LINK_RECHECK_HOURS=24

# ---- Freeway: local AI gateway (recommended fallback instead of Ollama) ----
# Freeway (https://github.com/vinaygiri/freeway) fronts ~32 free-tier providers behind one
# local endpoint, with quota-aware routing and automatic failover between them. It must be
# running: check with `curl http://localhost:8092/health` -> {"status":"healthy"}.
#
# CONFIGURE IT IN THE UI, like every other provider: /settings -> Add provider ->
# kind "Freeway (local gateway)" (or the Quick preset). The key field there is OPTIONAL and
# falls back to FREEWAY_API_KEY below, so you can keep the key in either place.
#
# WHERE IT SITS IN THE CHAIN: your own cloud keys first, then Freeway, then Ollama last. So
# when a Gemini/Anthropic daily quota exhausts, ratings and generation degrade to another
# capable model instead of to local llama3.2. Activate it in /settings to make it primary.
# With NO provider configured and no cloud key, Freeway becomes the default.
#
# These env vars are the fallback for the UI config (and the only way to enable Freeway
# without adding a provider row). Leave FREEWAY_API_KEY unset and nothing changes.
# Issue/revoke a per-app key in Freeway's admin under Monitor -> API Keys (shown once).
# Note the free tier behind the gateway is ~50 requests/day and 20/minute.
# FREEWAY_API_KEY=fw_...
# Freeway's stock default port is 8082; this machine is configured for 8092.
# FREEWAY_BASE_URL=http://localhost:8092
# Optional "provider/model" pin (e.g. cerebras/gpt-oss-120b). Omit to let Freeway route.
# FREEWAY_MODEL=auto
# Request timeout. Default scales with the token budget (60ms/token, floor 120s) because the
# gateway's default model is a reasoning model: a 4096-token evaluation needs ~4 minutes of
# headroom, and a flat 120s cap made real evaluations fall through to the next provider.
# FREEWAY_TIMEOUT_MS=245000

# ---- Sync performance & new sources (Phase 3) ----
# ingest:all is a concurrency pool (scripts/ingest-all.ts), not a chain of && calls.
# INGEST_CONCURRENCY=4
# INGEST_ONLY=hn,lever            # run only these sources (testing)
#
# Career-page discovery (scripts/ingest-companies.ts): 160 seeds, was 27-107 min, now ~35s warm.
# DISCOVER_CONCURRENCY=4
# DISCOVER_LIMIT=0                # >0 = only the first N seeds (testing)
# DISCOVERY_PROBE_TTL_DAYS=14     # how long a seed's detected ATS is cached
#
# ts-jobspy source (Indeed + LinkedIn) — the ONLY source with a real recency filter, and it
# reports posting dates (100% coverage measured, vs 43% NULL across the older sources).
# JOBSPY_HOURS=168                # recency window; 168 = last 7 days
# JOBSPY_WANTED=25                # results per (role x site x location) query
# JOBSPY_SITES=indeed,linkedin    # only these two are operational in the library
# JOBSPY_LOCATIONS=India,Remote
# JOBSPY_MAX_ROLES=4              # caps the query matrix (LinkedIn rate-limits)
#
# Prune (scripts/prune-stale.ts)
# MAX_POST_AGE_DAYS=180           # retire postings older than this regardless of last_seen_at
# MAX_EXPIRY_RATIO=0.4            # refuse to expire more than this share in one run
# PRUNE_FORCE=1                   # override that guard
# PRUNE_PURGE_DAYS=30             # PERMANENTLY delete orphaned rows expired >N days, then VACUUM
# HIRESIGNAL_DB=/path/copy.db     # point prune at a COPY to test expiry rules safely
# HN_MAX_AGE_MONTHS=6             # HN "Who is hiring" threads newer than this only
