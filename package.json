  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ingest": "npx ts-node scripts/ingest-greenhouse.ts && npx ts-node scripts/ingest-lever.ts",
    "ingest:hn": "npx ts-node scripts/ingest-hn.ts",
    "ingest:remote": "npx ts-node scripts/ingest-remoteok.ts && npx ts-node scripts/ingest-remotive.ts",
    "ingest:ashby": "npx ts-node scripts/ingest-ashby.ts",
    "ingest:himalayas": "npx ts-node scripts/ingest-himalayas.ts",
    "ingest:wwr": "npx ts-node scripts/ingest-wwr.ts",
    "ingest:4dayweek": "npx ts-node scripts/ingest-4dayweek.ts",
    "ingest:linkedin": "npx ts-node scripts/ingest-linkedin.ts",
    "ingest:hirist": "npx ts-node scripts/ingest-hirist.ts",
    "ingest:layoffs": "npx ts-node scripts/ingest-layoffs.ts",
    "login:naukri": "npx ts-node scripts/login-naukri.ts",
    "login:reset": "npx ts-node scripts/login-naukri.ts --reset",
    "ingest:naukri": "npx ts-node scripts/ingest-naukri.ts",
    "ingest:jobspy": "npx ts-node scripts/ingest-jobspy.ts",
    "spike:jobspy": "npx ts-node scripts/spike-jobspy.ts",
    "ingest:all": "npx ts-node scripts/ingest-all.ts",
    "discover": "npx ts-node scripts/ingest-companies.ts",
    "embed": "npx ts-node scripts/embed-jobs.ts",
    "reembed": "npx ts-node scripts/reembed.ts",
    "prune": "npx ts-node scripts/prune-stale.ts",
    "verify:links": "npx ts-node scripts/verify-links.ts",
    "evaluate:top": "npx ts-node scripts/evaluate-top.ts",
    "test-apply": "npx ts-node scripts/test-apply.ts",
    "test-freeway": "npx ts-node scripts/test-freeway.ts",
    "backup": "npx ts-node scripts/backup.ts",
    "daily": "npm run ingest:all && npm run discover && npm run embed && npm run prune && npm run verify:links && npm run evaluate:top",
    "db:reset": "node -e \"require('fs').unlinkSync('./data/hiresignal.db')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:directory": "npx ts-node scripts/sync-company-directory.ts"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.6.1",
    "geist": "^1.7.0",
    "lucide-react": "^1.11.0",
    "next": "^15.5.24",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.59.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.7",
    "swr": "^2.4.1",
